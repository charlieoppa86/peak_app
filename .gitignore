# Environment variables (Supabase keys — copy .env.example to .env and fill in)
.env

# Build config — prod.json contains real ad IDs, never commit
config/prod.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS Pods (dependency manager)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
macos/Pods/
macos/.symlinks/

# Flutter generated
.flutter-plugins
ios/Flutter/flutter_export_environment.sh
macos/Flutter/ephemeral/

# Firebase — API keys, never commit real configs
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android signing — never commit keystore or passwords
android/key.properties
*.jks
*.keystore

# Supabase CLI 임시 파일
supabase/.temp/

# Claude 어시스턴트 메모리
memory/
